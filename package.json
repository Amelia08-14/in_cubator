{
  "name": "in-cubator-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:api": "npm run dev --prefix backend",
    "build": "next build",
    "build:web": "next build",
    "build:api": "npm run build --prefix backend",
    "build:all": "npm run build:api && npm run build:web",
    "start": "next start",
    "start:web": "next start",
    "start:api": "npm run start --prefix backend",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:api": "npm run typecheck --prefix backend",
    "db:generate": "npm run prisma:generate --prefix backend",
    "db:validate": "npm run prisma:validate --prefix backend",
    "db:migrate": "npm run db:migrate:dev --prefix backend",
    "db:migrate:deploy": "npm run db:migrate:deploy --prefix backend"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-progress": "^1.1.16",
    "@tanstack/react-query": "^5.101.4",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
