NODE_ENV=development
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api
TRUST_PROXY=1

# Utilisée par Prisma CLI et analysée par l'adaptateur MariaDB au runtime.
DATABASE_URL=mysql://in_cubator:change-me@127.0.0.1:3306/in_cubator
DATABASE_CONNECTION_LIMIT=10

CORS_ORIGINS=http://localhost:3000
JSON_BODY_LIMIT=1mb

# Utiliser deux secrets différents d'au moins 32 caractères en production.
JWT_ACCESS_SECRET=replace-with-a-long-unique-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-unique-refresh-secret
JWT_ISSUER=in-cubator-api
JWT_AUDIENCE=in-cubator-web
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

ACCESS_COOKIE_NAME=in_cubator_access
REFRESH_COOKIE_NAME=in_cubator_refresh
# Requis à la racine pour permettre aux Server Components de valider la session.
REFRESH_COOKIE_PATH=/
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.com

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10
