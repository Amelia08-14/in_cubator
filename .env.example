# Example environment variables for local development
# Copy this file to `.env` and fill the values before running the app.

# MySQL connection for XAMPP / local MySQL
# Format: mysql://DB_USER:DB_PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL="mysql://root:password@127.0.0.1:3306/incubator_dev"

# NextAuth settings kept only during the incremental auth migration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change_this_to_a_secure_random_value"

# Express API used by the Next.js rewrite /api/v2/* -> API /api/*
API_INTERNAL_URL="http://127.0.0.1:4000"
NEXT_PUBLIC_API_BASE_URL="/api/v2"

# Secure auth secrets owned by the Express API
JWT_ACCESS_SECRET="replace_with_at_least_32_random_characters"
JWT_REFRESH_SECRET="replace_with_another_32_random_characters"
JWT_ACCESS_TTL_SECONDS="900"
JWT_REFRESH_TTL_SECONDS="2592000"
ACCESS_COOKIE_NAME="in_cubator_access"
REFRESH_COOKIE_NAME="in_cubator_refresh"
# Session de l'administration, indépendante de celle des membres.
ADMIN_ACCESS_COOKIE_NAME="in_cubator_admin_access"
ADMIN_REFRESH_COOKIE_NAME="in_cubator_admin_refresh"
REFRESH_COOKIE_PATH="/"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

# Browser origin allowed by Express in local development
CORS_ORIGINS="http://localhost:3000"

# Répertoire persistant hors de public/ pour les documents privés de transition
PRIVATE_STORAGE_DIR="./storage/private"

# Répertoire persistant des images publiques envoyées depuis le back-office (couvertures d'évènements)
PUBLIC_MEDIA_DIR="./storage/public"

# Node environment
NODE_ENV=development
